{
  "name": "nexus-ai",
  "version": "1.0.5",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "prisma db push --schema=./schema.prisma --skip-generate && node server.js",
    "dev": "node --watch server.js",
    "db:push": "prisma db push --schema=./schema.prisma",
    "postinstall": "prisma generate --schema=./schema.prisma",
    "railway:start": "prisma db push --schema=./schema.prisma --skip-generate && node server.js"
  },
  "dependencies": {
    "@prisma/client": "6.18.0",
    "bcryptjs": "3.0.2",
    "cookie-parser": "1.4.7",
    "express": "5.1.0",
    "express-session": "1.18.2",
    "helmet": "8.1.0",
    "multer": "2.0.2",
    "passport": "0.7.0",
    "passport-google-oauth20": "2.0.0",
    "pg": "8.16.3",
    "prisma": "6.18.0"
  },
  "engines": {
    "node": "22.x",
    "npm": ">=10"
  }
}